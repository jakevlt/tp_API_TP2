{
  "info": {
    "name": "Bibliothèque API - TP3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "TP3 - SQLite + JWT. Renseigner admin_password (valeur de ADMIN_PASSWORD dans .env) puis Run collection dans l'ordre."
  },
  "item": [
    {
      "name": "POST /users - création (role ignoré)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Lecteur Postman\",\n  \"email\": \"{{login}}@example.com\",\n  \"login\": \"{{login}}\",\n  \"password\": \"MotDePasse123\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"login\", \"postman\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Rôle forcé à lecteur\", () => pm.expect(pm.response.json().role).to.eql(\"lecteur\"));",
              "pm.test(\"Pas de mot de passe ni de hash\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /login - connexion correcte (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"MotDePasse123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JWT en 3 parties\", () => pm.expect(pm.response.json().access_token.split(\".\").length).to.eql(3));",
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
