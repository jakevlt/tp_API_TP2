    {
      "name": "GET /profile - JWT modifié",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_modifie}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/profile",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "profile"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = pm.collectionVariables.get(\"token\");",
              "pm.collectionVariables.set(\"token_modifie\", t.slice(0, -1) + (t.endsWith(\"x\") ? \"y\" : \"x\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
