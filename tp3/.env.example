# Copier ce fichier en .env puis remplacer les valeurs (le fichier .env n'est jamais versionné).
# Clé secrète de signature des JWT : générer une vraie valeur avec
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Base de données : SQLite par défaut
DATABASE_URL=sqlite:///./bibliotheque.db
# PostgreSQL (après : pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://bibliotheque:motdepasse@localhost:5432/bibliotheque

# Compte administrateur créé au premier démarrage (si absent)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-solide
