# Copier ce fichier en .env puis remplacer les valeurs. Le fichier .env n'est JAMAIS versionné.
# Clé de signature des JWT (longue et aléatoire), à générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacer_par_une_valeur_de_developpement_longue_et_aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Base SQLite (fichier créé au premier lancement)
DATABASE_URL=sqlite:///./bibliotheque.db
# Pour aller plus loin - PostgreSQL (après : pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://bibliotheque:motdepasse@localhost:5432/bibliotheque

# Compte administrateur créé au premier lancement (s'il n'existe pas)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_solide
