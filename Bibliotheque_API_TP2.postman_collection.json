{
  "info": {
    "name": "Bibliothèque API - TP2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "TP2 - tests positifs et négatifs. Exécuter dans l'ordre (Run collection) : le jeton de /login est enregistré automatiquement dans la variable {{token}}."
  },
  "item": [
    {
      "name": "POST /users - création utilisateur",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{user_id}},\n  \"nom\": \"Testeur Postman\",\n  \"email\": \"{{login}}@example.com\",\n  \"login\": \"{{login}}\",\n  \"password\": \"MotDePasse123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"login\", \"postman\" + Date.now());",
              "pm.collectionVariables.set(\"user_id\", Math.floor(Math.random()*100000)+10);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Ni password ni password_hash dans la réponse\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"password\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /login - connexion correcte",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"MotDePasse123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut HTTP 200\", () => pm.response.to.have.status(200));",
              "const token = pm.response.json().token;",
              "pm.test(\"Un jeton est renvoyé\", () => pm.expect(token).to.be.a(\"string\").and.not.equal(\"123456\"));",
              "pm.collectionVariables.set(\"token\", token);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /login - mauvais mot de passe",
      "request": {
